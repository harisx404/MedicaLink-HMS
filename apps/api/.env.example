# ─────────────────────────────────────────────
#  MedicaLink HMS — Backend Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────
# Local Docker:  mongodb://admin:adminpassword@localhost:27017
# Atlas:         mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://admin:adminpassword@localhost:27017
MAIN_DB_NAME=medicalink_main

# ── Redis ─────────────────────────────────────
# Local Docker:  redis://localhost:6379
# Upstash:       redis://default:token@host:port
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary (File Uploads) ─────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (SMTP) ──────────────────────────────
# For Gmail: use App Password (not your regular password)
# In production: use AWS SES or SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@medicalink.app

# ── Stripe (Payments) ────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key

# ── OpenAI (AI Features — Phase 14+) ─────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ── URLs ──────────────────────────────────────
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000
