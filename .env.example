NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/medicalink
MAIN_DB_NAME=medicalink_main

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Crypto
JWT_ACCESS_SECRET=your_super_secret_access_key_here_must_be_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_must_be_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=your_super_secret_encryption_key_here_must_be_32_chars

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@medicalink.app

# Stripe (Optional)
STRIPE_SECRET_KEY=

# Google Gemini AI (Optional)
GEMINI_API_KEY=

# OpenAI (Legacy, Optional)
OPENAI_API_KEY=

# Twilio SMS & WhatsApp (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# URLs
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000
