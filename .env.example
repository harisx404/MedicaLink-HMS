# ============================================================================
# MedicaLink HMS — Environment Configuration
# ============================================================================
# Copy this file to .env in both apps/api/ and the project root.
# Variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] enable additional features when configured.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB [REQUIRED] ─────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/medicalink
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/medicalink
MAIN_DB_NAME=medicalink_main

# ── Redis ───────────────────────────────────────────────────────────────────
# Local development (TCP via ioredis) — start with: docker-compose up -d
REDIS_URL=redis://localhost:6379

# Serverless/Vercel production (HTTP via Upstash) [OPTIONAL]
# Get credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Authentication [REQUIRED] ──────────────────────────────────────────────
# Generate secure keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_access_key_here_must_be_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_must_be_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Encryption [REQUIRED] ──────────────────────────────────────────────────
# AES-256-GCM key for encrypting sensitive patient data (PII)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_super_secret_encryption_key_here_must_be_32_chars

# ── Cloudinary [OPTIONAL] ──────────────────────────────────────────────────
# Image and file upload service — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email SMTP [OPTIONAL] ──────────────────────────────────────────────────
# For password resets, welcome emails, appointment reminders
# Works with Gmail, SendGrid, Mailgun, or any SMTP provider
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@medicalink.app

# ── Stripe [OPTIONAL] ──────────────────────────────────────────────────────
# Payment processing — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ── AI Services [OPTIONAL] ─────────────────────────────────────────────────
# Google Gemini — clinical summaries, AI chatbot
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (legacy fallback) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Twilio [OPTIONAL] ──────────────────────────────────────────────────────
# SMS and WhatsApp notifications — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── URLs ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000
